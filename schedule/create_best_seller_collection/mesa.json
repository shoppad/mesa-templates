{
    "key": "schedule/create_best_seller_collection",
    "name": "Generate Daily Product Rankings Based On Sales Data",
    "version": "1.0.0",
    "enabled": false,
    "setup": false,
    "config": {
        "inputs": [
            {
                "schema": 2,
                "trigger_type": "input",
                "type": "schedule",
                "name": "Schedule",
                "key": "schedule",
                "operation_id": "schedule",
                "metadata": {
                    "enqueue_type": "schedule",
                    "schedule": "@daily:0 0 * * *"
                },
                "local_fields": [],
                "selected_fields": ["enqueue_type", "schedule"],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 3,
                "trigger_type": "output",
                "type": "transform",
                "entity": "mapping",
                "name": "Setup Variables",
                "key": "transform",
                "operation_id": "mapping",
                "metadata": {
                    "mapping": [
                        {
                            "destination": "Days Back"
                        },
                        {
                            "destination": "Limit"
                        },
                        {
                            "destination": "Collection ID"
                        }
                    ],
                    "script": "transform.js"
                },
                "local_fields": [
                    {
                        "key": "mapping",
                        "type": "mapping",
                        "tokens": "brackets",
                        "location": "required"
                    }
                ],
                "selected_fields": ["script"],
                "on_error": "default",
                "weight": 0
            },
            {
                "schema": 4,
                "trigger_type": "output",
                "type": "data",
                "entity": "record",
                "action": "custom_query",
                "name": "Custom SQL Query",
                "version": "v2",
                "key": "data",
                "operation_id": "get_database_custom_query",
                "metadata": {
                    "api_endpoint": "get \/{database}\/{table}",
                    "query": "SELECT \n    ROW_NUMBER() OVER (ORDER BY sum(\"Product Quantity\") DESC) AS \"Best Sellers Index\",\n    \"Product ID\",\n    \"Product Title\",\n    sum(\"Product Quantity\") AS \"Quantity\"\nFROM \"Shopify Orders\" \nWHERE \"Order Created At\" > CURRENT_DATE - INTERVAL '{{transform[\"Days Back\"]}} days' \nGROUP BY \"Product ID\", \"Product Title\"\nORDER BY \"Quantity\" DESC\nLIMIT {{transform[\"Limit\"]}}\n"
                },
                "local_fields": [],
                "selected_fields": ["query"],
                "on_error": "default",
                "weight": 1
            },
            {
                "schema": 4,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "collection",
                "action": "create",
                "name": "Get List of Products from Best Sellers Collection",
                "version": "v2",
                "key": "shopify_4",
                "operation_id": "collectionListProducts",
                "metadata": {
                    "api_endpoint": "post \/graphql\/collection\/listProducts",
                    "body": {
                        "collectionId": "{{transform[\"Collection ID\"]}}",
                        "limit": "100"
                    }
                },
                "local_fields": [],
                "selected_fields": ["body.limit"],
                "on_error": "default",
                "weight": 2
            },
            {
                "schema": 5.1,
                "trigger_type": "output",
                "type": "loop",
                "entity": "loop",
                "name": "Loop over Products in Best Sellers Collection",
                "version": "v3",
                "key": "loop",
                "operation_id": "loop_loop",
                "metadata": {
                    "key": "{{shopify_4}}"
                },
                "local_fields": [],
                "selected_fields": ["key"],
                "on_error": "default",
                "weight": 3
            },
            {
                "schema": 4,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "product",
                "action": "create",
                "name": "Set Best Sellers Index Product Metafield to 0",
                "version": "v2",
                "key": "shopify",
                "operation_id": "productMetafieldSet",
                "metadata": {
                    "api_endpoint": "post \/graphql\/product\/metafieldSet",
                    "body": {
                        "productId": "{{loop.id}}",
                        "namespace": "custom",
                        "key": "best_sellers_index",
                        "type": "number_integer",
                        "value": "0"
                    },
                    "trigger_parent_key": "loop"
                },
                "local_fields": [],
                "selected_fields": ["body"],
                "on_error": "default",
                "weight": 4
            },
            {
                "schema": 5.1,
                "trigger_type": "output",
                "type": "loop",
                "entity": "end",
                "name": "Loop End",
                "version": "v3",
                "key": "loop_1",
                "operation_id": "loop_end",
                "metadata": {
                    "trigger_manager_key": "loop",
                    "trigger_parent_key": "loop"
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 5
            },
            {
                "schema": 5.1,
                "trigger_type": "output",
                "type": "loop",
                "entity": "loop",
                "name": "Loop over Best Selling Products",
                "version": "v3",
                "key": "loop_2",
                "operation_id": "loop_loop",
                "metadata": {
                    "key": "{{data}}"
                },
                "local_fields": [],
                "selected_fields": ["key"],
                "on_error": "default",
                "weight": 6
            },
            {
                "schema": 4,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "product",
                "action": "retrieve",
                "name": "Retrieve Product",
                "version": "v2",
                "key": "shopify_1",
                "operation_id": "product",
                "metadata": {
                    "api_endpoint": "get \/graphql\/product\/retrieve",
                    "body": {
                        "id": "{{loop_2[\"Product ID\"]}}"
                    },
                    "trigger_parent_key": "loop_2"
                },
                "local_fields": [],
                "selected_fields": ["body"],
                "on_error": "default",
                "weight": 7
            },
            {
                "schema": 4,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "product",
                "action": "create",
                "name": "Set Best Sellers Index Product Metafield By Order",
                "version": "v2",
                "key": "shopify_2",
                "operation_id": "productMetafieldSet",
                "metadata": {
                    "api_endpoint": "post \/graphql\/product\/metafieldSet",
                    "body": {
                        "productId": "{{shopify_1.id}}",
                        "namespace": "custom",
                        "key": "best_sellers_index",
                        "type": "number_integer",
                        "value": "{{loop_2[\"Best Sellers Index\"]}}"
                    },
                    "trigger_parent_key": "loop_2"
                },
                "local_fields": [],
                "selected_fields": ["body"],
                "on_error": "default",
                "weight": 8
            },
            {
                "schema": 2,
                "trigger_type": "output",
                "type": "custom",
                "name": "Sort Products in Best Sellers Collection",
                "key": "custom",
                "operation_id": "custom",
                "metadata": {
                    "trigger_parent_key": "loop_2",
                    "script": "custom.js"
                },
                "local_fields": [],
                "selected_fields": ["script"],
                "on_error": "default",
                "weight": 9
            },
            {
                "schema": 5.1,
                "trigger_type": "output",
                "type": "loop",
                "entity": "end",
                "name": "Loop End",
                "version": "v3",
                "key": "loop_3",
                "operation_id": "loop_end",
                "metadata": {
                    "trigger_manager_key": "loop_2",
                    "trigger_parent_key": "loop_2"
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 10
            }
        ]
    }
}

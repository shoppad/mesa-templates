{
    "key": "schedule/shopify_collection_price_change",
    "name": "Schedule a Shopify Collection Price Change",
    "version": "1.0.0",
    "enabled": false,
    "setup": true,
    "config": {
        "inputs": [
            {
                "schema": 2,
                "trigger_type": "input",
                "type": "schedule",
                "name": "Schedule",
                "key": "schedule",
                "operation_id": "schedule",
                "metadata": {
                    "schedule": null,
                    "enqueue_type": "datetime",
                    "datetime": "{{ template | label: 'Select a date to schedule the collection price change' }}"
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "version": "v2",
                "entity": "collection",
                "action": "create",
                "name": "Get List of Collections' Products",
                "key": "shopify",
                "operation_id": "collectionListProducts",
                "metadata": {
                    "api_endpoint": "post /graphql/collection/listProducts",
                    "body": {
                        "collectionId": "{{ template | label: 'What is the collection ID?', description: 'To find your Shopify collection ID, log in to your Shopify admin, go to **Products > Collections**, and click on the collection you want. In the browser''s address bar, you''ll see a URL like https://your-store.myshopify.com/admin/collections/123456789012 —the number at the end is your collection ID. Enter that ID here.', tokens: false }}",
                        "limit": 250
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "collectionId",
                    "limit",
                    "body",
                    "body.collectionId",
                    "body.limit"
                ],
                "on_error": "default",
                "weight": 0
            },
            {
                "schema": 5.1,
                "trigger_type": "output",
                "type": "loop",
                "entity": "loop",
                "name": "Loop Over Products",
                "version": "v3",
                "key": "loop",
                "operation_id": "loop_loop",
                "metadata": {
                    "key": "{{shopify}}",
                    "filter": {
                        "comparison": "equals",
                        "additional": [
                            {
                                "operator": "and",
                                "comparison": "equals"
                            }
                        ]
                    }
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 1
            },
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "version": "v2",
                "entity": "productvariant",
                "action": "list",
                "name": "Get List of Product Variants",
                "key": "shopify_1",
                "operation_id": "productVariants",
                "metadata": {
                    "api_endpoint": "get /graphql/productVariants",
                    "trigger_parent_key": "loop",
                    "body": {
                        "product_id": "{{loop.id}}",
                        "limit": 100
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "product_id",
                    "limit",
                    "body",
                    "body.product_id",
                    "body.limit"
                ],
                "on_error": "default",
                "weight": 2
            },
            {
                "schema": 5.1,
                "trigger_type": "output",
                "type": "loop",
                "entity": "loop",
                "name": "Loop Over Product Variants",
                "version": "v3",
                "key": "loop_2",
                "operation_id": "loop_loop",
                "metadata": {
                    "trigger_parent_key": "loop",
                    "key": "{{shopify_1}}",
                    "filter": {
                        "comparison": "equals",
                        "additional": [
                            {
                                "operator": "and",
                                "comparison": "equals"
                            }
                        ]
                    }
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 3
            },
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "productvariant",
                "action": "retrieve",
                "name": "Retrieve Product Variant",
                "version": "v2",
                "key": "shopify_2",
                "operation_id": "productVariant",
                "metadata": {
                    "api_endpoint": "get /graphql/productVariant/retrieve",
                    "body": {
                        "id": "{{loop_2.id}}"
                    },
                    "trigger_parent_key": "loop_2"
                },
                "local_fields": [],
                "selected_fields": [
                    "id",
                    "body",
                    "body.id"
                ],
                "on_error": "default",
                "weight": 4
            },
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "productvariant",
                "action": "update",
                "name": "Update Product Variant",
                "version": "v2",
                "key": "shopify_3",
                "operation_id": "productVariantUpdate",
                "metadata": {
                    "api_endpoint": "post /graphql/productVariant/update",
                    "body": {
                        "productId": "{{loop.id}}",
                        "id": "{{shopify_2.id}}",
                        "price": "{{ template | label: 'How much would you like to reduce the price?', description: 'By default, this template will reduce prices in your selected collection by 25%. If you''d like to apply a different discount, simply double-click the variable and change the number after `times:` to match the percentage you''d like to keep. For example, to apply a 15% discount, use 0.85 instead, like this: `{{shopify_2.price | times: 0.85 | round: 2}}`.', default: '{{shopify_2.price | times: 0.75 | round: 2}}' }}"
                    },
                    "trigger_parent_key": "loop_2"
                },
                "local_fields": [],
                "selected_fields": [
                    "productId",
                    "id",
                    "price",
                    "body",
                    "body.productId",
                    "body.id",
                    "body.price"
                ],
                "on_error": "default",
                "weight": 5
            },
            {
                "schema": 5.1,
                "trigger_type": "output",
                "type": "loop",
                "entity": "end",
                "name": "Loop End",
                "version": "v3",
                "key": "loop_3",
                "operation_id": "loop_end",
                "metadata": {
                    "trigger_manager_key": "loop_2",
                    "trigger_parent_key": "loop_2"
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 6
            },
            {
                "schema": 5.1,
                "trigger_type": "output",
                "type": "loop",
                "entity": "end",
                "name": "Loop End",
                "version": "v3",
                "key": "loop_1",
                "operation_id": "loop_end",
                "metadata": {
                    "trigger_manager_key": "loop",
                    "trigger_parent_key": "loop"
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 7
            }
        ]
    }
}

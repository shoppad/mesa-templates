{
    "key": "add_shopify_customer_tag",
    "name": "Automatically Tag Shopify Customers Who Purchase Subscriptions",
    "version": "1.0.0",
    "enabled": false,
    "setup": true,
    "config": {
        "inputs": [
            {
                "schema": 2,
                "trigger_type": "input",
                "type": "recharge",
                "entity": "subscription",
                "action": "subscription/created",
                "name": "Subscription Created",
                "key": "recharge_subscription",
                "operation_id": "subscription_created",
                "metadata": [],
                "local_fields": [],
                "selected_fields": ["topic"],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 2,
                "trigger_type": "output",
                "type": "recharge",
                "entity": "customer",
                "action": "retrieve",
                "name": "Retrieve Customer",
                "key": "recharge_customer",
                "operation_id": "get-customers-customer_id",
                "metadata": {
                    "api_endpoint": "GET /customers/{{customer_id}}",
                    "customer_id": "{{recharge_subscription.customer_id}}"
                },
                "local_fields": [],
                "selected_fields": ["customer_id"],
                "on_error": "default",
                "weight": 0
            },
            {
                "schema": 3,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "customer",
                "action": "retrieve",
                "name": "Retrieve Customer",
                "version": "v2",
                "key": "shopify_customer_1",
                "operation_id": "customer",
                "metadata": {
                    "api_endpoint": "get /graphql/customer/retrieve",
                    "body": {
                        "id": "{{recharge_customer.external_customer_id.ecommerce}}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "id",
                    "body",
                    "body.id"
                ],
                "on_error": "default",
                "weight": 1
            },
            {
                "schema": 3,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "customer",
                "action": "add",
                "name": "Customer Add Tag",
                "version": "v2",
                "key": "shopify_customer",
                "operation_id": "customerTagsAdd",
                "metadata": {
                    "api_endpoint": "post /graphql/customerTags/add",
                    "body": {
                        "id": "{{shopify_customer_1.id}}",
                        "tags": "Recharge Tag"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "id",
                    "tags",
                    "body",
                    "body.id",
                    "body.tags"
                ],
                "on_error": "default",
                "weight": 2
            }
        ]
    }
}

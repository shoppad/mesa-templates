{
    "key": "recharge/order/add_free_product_to_first_subscription_order",
    "name": "Add a free product to a customer's first Recharge order",
    "version": "1.0.0",
    "seconds": 120,
    "enabled": false,
    "setup": true,
    "config": {
        "inputs": [
            {
                "schema": 2,
                "trigger_type": "input",
                "type": "recharge",
                "entity": "order",
                "action": "order/created",
                "name": "Order Created",
                "key": "recharge",
                "operation_id": "order_created",
                "metadata": [],
                "local_fields": [],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 4,
                "trigger_type": "output",
                "type": "recharge",
                "entity": "mesa_order_filter",
                "action": "list",
                "name": "Filter by Order Count of Subscription",
                "key": "recharge_1",
                "operation_id": "order_filter",
                "metadata": {
                    "api_endpoint": "get /mesa/orders/{order_id}/filter.json",
                    "path": {
                        "order_id": "{{recharge.external_order_id.ecommerce}}",
                        "number_of_orders": "{{ template | label: 'How many orders are needed in the customer''s subscription in order to receive a free product?', description: '', default: 1, type: 'number', tokens: false }}"
                    }
                },
                "local_fields": [],
                "on_error": "default",
                "weight": 0
            },
            {
                "schema": 3,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "order",
                "action": "create",
                "name": "Add Line Item to Order",
                "version": "v2",
                "key": "shopify",
                "operation_id": "post_mesa_orders_order_id_add-line-item",
                "metadata": {
                    "api_endpoint": "post /graphql/order/addLineItem",
                    "body": {
                        "id": "{{recharge.external_order_id.ecommerce}}",
                        "productId": "{{ template | label: 'What is the free product that will be added to the order?', description: '', tokens: true }}",
                        "variantId": "{{ template | label: 'What is the variant of the free product?', description: '', tokens: true }}",
                        "discountType": "Percentage",
                        "discountAmount": "100",
                        "allowDuplicates": true,
                        "notifyCustomer": "false",
                        "quantity": "1"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "id",
                    "productId",
                    "variantId",
                    "discountType",
                    "discountAmount",
                    "allowDuplicates",
                    "notifyCustomer",
                    "quantity",
                    "body",
                    "body.id",
                    "body.productId",
                    "body.variantId",
                    "body.discountType",
                    "body.discountAmount",
                    "body.allowDuplicates",
                    "body.notifyCustomer",
                    "body.quantity"
                ],
                "on_error": "default",
                "weight": 1
            }
        ]
    }
}
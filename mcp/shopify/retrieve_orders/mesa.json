{
    "key": "mcp/shopify/retrieve_orders",
    "name": "Retrieve Shopify Orders",
    "version": "1.0.0",
    "description": "",
    "seconds": 135,
    "enabled": true,
    "setup": true,
    "config": {
        "inputs": [
            {
                "schema": 4,
                "trigger_type": "input",
                "type": "ai",
                "entity": "skill",
                "action": "skill",
                "name": "Skill",
                "key": "skill",
                "operation_id": "post-skill",
                "metadata": {
                    "api_endpoint": "post /skill",
                    "body": {
                        "parameters": [
                            {
                                "key": "start_date",
                                "description": "iso format",
                                "type": "string",
                                "required": false
                            },
                            {
                                "key": "end_date",
                                "description": "iso format",
                                "type": "string",
                                "required": true
                            }
                        ]
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "json",
                    "body",
                    "body.parameters",
                    "body.parameters[].key",
                    "body.parameters[].type"
                ],
                "on_error": "default",
                "weight": 0,
                "version": "v3"
            }
        ],
        "outputs": [
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "order",
                "action": "list",
                "name": "Get List of Orders",
                "version": "v2",
                "key": "shopify",
                "operation_id": "orders",
                "metadata": {
                    "api_endpoint": "get /graphql/orders",
                    "body": {
                        "created_at_min": "{{skill.start_date}}",
                        "created_at_max": "{{skill.end_date}}",
                        "limit": "250"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "created_at_min",
                    "created_at_max",
                    "limit",
                    "body",
                    "body.created_at_min",
                    "body.created_at_max",
                    "body.limit"
                ],
                "on_error": "default",
                "weight": 0
            }
        ]
    }
}
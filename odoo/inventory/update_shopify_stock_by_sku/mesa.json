{
    "key": "odoo/inventory/update_shopify_stock_by_sku",
    "name": "Update Shopify Stock Levels Based on Odoo Inventory Changes",
    "version": "1.0.0",
    "enabled": false,
    "setup": true,
    "config": {
        "inputs": [
            {
                "schema": 4,
                "trigger_type": "input",
                "type": "odoo",
                "entity": "stock.quant",
                "action": "list-updated",
                "name": "Inventory Updated",
                "version": "v2",
                "key": "odoo",
                "operation_id": "stock.quant_updated",
                "metadata": {
                    "poll": "@hourly:0 * * * *"
                },
                "local_fields": [],
                "selected_fields": ["poll"],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "productvariant",
                "action": "create",
                "name": "Retrieve Product Variant Details from SKU",
                "version": "v2",
                "key": "shopify",
                "operation_id": "productSkuLookup",
                "metadata": {
                    "api_endpoint": "post /graphql/productVariant/skuLookup",
                    "body": {
                        "sku": "{{odoo.product_reference_code}}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "sku",
                    "body",
                    "body.sku"
                ],
                "on_error": "default",
                "weight": 0
            },
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "inventorylevel",
                "action": "create",
                "name": "Set Inventory Level By Variant",
                "version": "v2",
                "key": "shopify_1",
                "operation_id": "inventoryLevelSetByVariant",
                "metadata": {
                    "api_endpoint": "post /graphql/inventoryLevel/setByVariant",
                    "body": {
                        "inventoryItemId": "{{shopify.inventory_item_id}}",
                        "locationId": "{{ template | label: 'What is your store''s location where the inventory will be updated?', description: 'Make sure this is the correct location and it is enabled before continuing.' , tokens: false }}",
                        "quantity": "{{odoo.available_quantity}}",
                        "reason": "correction"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "inventoryItemId",
                    "locationId",
                    "quantity",
                    "reason",
                    "body",
                    "body.inventoryItemId",
                    "body.locationId",
                    "body.quantity",
                    "body.reason"
                ],
                "on_error": "default",
                "weight": 1
            }
        ]
    }
}

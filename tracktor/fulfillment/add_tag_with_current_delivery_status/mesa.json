{
    "key": "tracktor/fulfillment/add_tag_with_current_delivery_status",
    "name": "Tag Shopify Orders with Fulfillment Status Updates",
    "version": "1.0.0",
    "enabled": false,
    "setup": true,
    "config": {
        "inputs": [
            {
                "schema": 2,
                "trigger_type": "input",
                "type": "tracktor",
                "entity": "fulfillment",
                "action": "fulfillment/all",
                "name": "Fulfillment Status Updated",
                "key": "tracktor_fulfillment",
                "metadata": [],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 3,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "order",
                "action": "retrieve",
                "name": "Retrieve Order",
                "version": "v2",
                "key": "shopify_order",
                "operation_id": "order",
                "metadata": {
                    "api_endpoint": "get /graphql/order/retrieve",
                    "body": {
                        "id": "{{tracktor_fulfillment.order_id}}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "id",
                    "body",
                    "body.id"
                ],
                "on_error": "default",
                "weight": 0
            },
            {
                "schema": 3,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "order",
                "action": "add",
                "name": "Order Add Tag",
                "version": "v2",
                "key": "shopify_order_1",
                "operation_id": "orderTagsAdd",
                "metadata": {
                    "api_endpoint": "post /graphql/orderTags/add",
                    "body": {
                        "id": "{{shopify_order.id}}",
                        "tags": "{{tracktor_fulfillment.latest_status.label}}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "id",
                    "tags",
                    "body",
                    "body.id",
                    "body.tags"
                ],
                "on_error": "default",
                "weight": 1
            }
        ],
        "storage": []
    }
}
{
    "key": "tracktor/fulfillment/send_status_to_klaviyo",
    "name": "Send Shopify In-Transit Fulfillment Updates to Klaviyo",
    "version": "1.0.0",
    "enabled": false,
    "setup": true,
    "config": {
        "inputs": [
            {
                "schema": 2,
                "trigger_type": "input",
                "type": "tracktor",
                "entity": "fulfillment",
                "action": "fulfillment\/in_transit",
                "name": "Fulfillment Status is In Transit",
                "key": "tracktor",
                "operation_id": "fulfillment_in_transit",
                "metadata": [],
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "order",
                "action": "retrieve",
                "name": "Retrieve Order",
                "version": "v2",
                "key": "shopify",
                "operation_id": "order",
                "metadata": {
                    "api_endpoint": "get /graphql/order/retrieve",
                    "body": {
                        "id": "{{tracktor.order_id}}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "id",
                    "body",
                    "body.id"
                ],
                "on_error": "default",
                "weight": 0
            },
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "customer",
                "action": "retrieve",
                "name": "Retrieve Customer",
                "version": "v2",
                "key": "shopify_1",
                "operation_id": "customer",
                "metadata": {
                    "api_endpoint": "get /graphql/customer/retrieve",
                    "body": {
                        "id": "{{shopify.customer.id}}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "id",
                    "body",
                    "body.id"
                ],
                "on_error": "default",
                "weight": 1
            },
            {
                "schema": 4,
                "trigger_type": "output",
                "type": "klaviyo",
                "entity": "event",
                "action": "create",
                "name": "Create Event",
                "version": "v4",
                "key": "klaviyo",
                "operation_id": "mesa_create_event_custom",
                "metadata": {
                    "api_endpoint": "post \/mesa\/api\/events",
                    "body": {
                        "mode": "create",
                        "properties": [
                            {
                                "key": "order_id",
                                "value": "{{shopify.legacyResourceId}}"
                            },
                            {
                                "key": "order_name",
                                "value": "{{shopify.name}}"
                            }
                        ],
                        "profile": {
                            "email": "{{shopify_1.defaultEmailAddress.emailAddress}}"
                        },
                        "metric": {
                            "name": "Tracktor: Fulfillment Status In Transit"
                        }
                    }
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 2
            }
        ]
    }
}
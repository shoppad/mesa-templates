{
    "key": "square/order/create_shopify_order",
    "name": "Automatically Create Shopify Orders from Square Orders",
    "version": "1.0.0",
    "enabled": false,
    "setup": true,
    "config": {
        "inputs": [
            {
                "schema": 4,
                "trigger_type": "input",
                "type": "square",
                "entity": "order",
                "action": "list-created",
                "name": "Order Created",
                "version": "v2",
                "key": "square",
                "operation_id": "order_created",
                "metadata": {
                    "api_endpoint": "get /orders",
                    "poll": "@hourly:0 * * * *"
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "order",
                "action": "create",
                "name": "Create Order",
                "version": "v2",
                "key": "shopify",
                "operation_id": "orderCreate",
                "metadata": {
                    "api_endpoint": "post /graphql/order/create",
                    "body": {
                        "fulfillmentStatus": "FULFILLED",
                        "inventoryBehaviour": "BYPASS",
                        "sourceName": "Square",
                        "discountCode": {
                            "itemFixedDiscountCode": {
                                "code": "Square discount",
                                "amountSet": {
                                    "shopMoney": {
                                        "amount": "{{square.total_discount_money.amount}}",
                                        "currencyCode": "{{square.total_money.currency}}"
                                    }
                                }
                            }
                        },
                        "lineItems": [
                            {
                                "quantity": "{{square.line_items[].quantity}}",
                                "title": "{{square.line_items[].name}}",
                                "priceSet": {
                                    "shopMoney": {
                                        "amount": "{{square.line_items[].base_price_money.amount}}",
                                        "currencyCode": "{{square.total_money.currency}}"
                                    }
                                }
                            }
                        ]
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "fulfillmentStatus",
                    "inventoryBehaviour",
                    "sourceName",
                    "discountCode",
                    "lineItems",
                    "body",
                    "body.fulfillmentStatus",
                    "body.inventoryBehaviour",
                    "body.sourceName",
                    "body.discountCode",
                    "body.lineItems"
                ],
                "on_error": "default",
                "weight": 0
            }
        ]
    }
}

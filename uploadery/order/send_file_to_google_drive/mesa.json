{
    "key": "uploadery/order/send_file_to_google_drive",
    "name": "Save Uploadery Files to Google Drive",
    "version": "1.0.0",
    "enabled": false,
    "setup": true,
    "config": {
        "inputs": [
            {
                "schema": 4,
                "trigger_type": "input",
                "type": "uploadery",
                "entity": "order",
                "action": "created",
                "name": "Order Created",
                "key": "uploadery",
                "operation_id": "order_created",
                "metadata": {
                    "field_name": "all_uploadery_upload_fields"
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 5.1,
                "trigger_type": "output",
                "type": "loop",
                "entity": "loop",
                "name": "Loop",
                "version": "v3",
                "key": "loop",
                "operation_id": "loop_loop",
                "metadata": {
                    "key": "{{uploadery.fields[]}}",
                    "return": false
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 0
            },
            {
                "schema": 2,
                "trigger_type": "output",
                "type": "googledrive",
                "entity": "file",
                "action": "save",
                "name": "Save File",
                "key": "googledrive",
                "operation_id": "file_save",
                "metadata": {
                    "trigger_parent_key": "loop",
                    "file_url": "{{loop.value}}",
                    "file_name": "{{uploadery.order.name}} -  {{filename}}"
                },
                "local_fields": [],
                "selected_fields": ["file_name"],
                "on_error": "default",
                "weight": 1
            },
            {
                "schema": 5.1,
                "trigger_type": "output",
                "type": "loop",
                "entity": "end",
                "name": "Loop End",
                "version": "v3",
                "key": "loop_1",
                "operation_id": "loop_end",
                "metadata": {
                    "trigger_manager_key": "loop",
                    "trigger_parent_key": "loop",
                    "return": false
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 2
            }
        ]
    }
}

{
    "key": "shopify/product/add_color_tag",
    "name": "Add a color tag to a product",
    "version": "2.0.0",
    "description": "Color coding has never been easier! This template adds color tags directly to your Shopify product information each time the product is created or updated. Easily classify and sort your products through this popular organization method.",
    "video": "",
    "tags": [],
    "source": "",
    "destination": "",
    "seconds": 60,
    "enabled": false,
    "logging": true,
    "debug": false,
    "setup": true,
    "config": {
        "inputs": [
            {
                "schema": 3,
                "trigger_type": "input",
                "type": "shopify",
                "version": "v2",
                "entity": "product",
                "action": "created",
                "name": "Product Created",
                "key": "shopify",
                "operation_id": "products_create",
                "metadata": [],
                "local_fields": [],
                "on_error": "default",
                "weight": 0
            }
        ],
        "storage": [],
        "outputs": [
            {
                "schema": 3,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "product",
                "action": "create",
                "name": "Retrieve Product Images",
                "version": "v2",
                "key": "shopify_3",
                "operation_id": "productImageRetrieve",
                "metadata": {
                    "api_endpoint": "post /graphql/product/imageRetrieve",
                    "body": {
                        "productId": "{{shopify.id}}",
                        "first": 1
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "productId",
                    "first",
                    "body",
                    "body.productId",
                    "body.first"
                ],
                "on_error": "default",
                "weight": 0
            },
            {
                "schema": 4,
                "trigger_type": "output",
                "type": "filter",
                "name": "Filter",
                "key": "filter",
                "metadata": {
                    "a": "Color:",
                    "comparison": "not in",
                    "b": "{{shopify.tags}}",
                    "additional": [
                        {
                            "operator": "and",
                            "a": "{{shopify_3.images[0].url}}",
                            "comparison": "is not empty"
                        }
                    ]
                },
                "local_fields": [],
                "on_error": "default",
                "weight": 1
            },
            {
                "schema": 2,
                "trigger_type": "output",
                "type": "image",
                "entity": "colors",
                "action": "identify",
                "name": "Identify Colors",
                "key": "image",
                "operation_id": "colors_identify",
                "metadata": {
                    "image_url": "{{shopify_3.images[0].url}}"
                },
                "local_fields": [],
                "on_error": "default",
                "weight": 2
            },
            {
                "schema": 3,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "product",
                "action": "add",
                "name": "Product Add Tag",
                "version": "v2",
                "key": "shopify_1",
                "operation_id": "productTagsAdd",
                "metadata": {
                    "api_endpoint": "post /graphql/productTags/add",
                    "body": {
                        "id": "{{shopify.id}}",
                        "tags": "Color: {{ image.colors | join: \", Color: \" }}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "id",
                    "tags",
                    "body",
                    "body.id",
                    "body.tags"
                ],
                "on_error": "default",
                "weight": 3
            }
        ]
    }
}

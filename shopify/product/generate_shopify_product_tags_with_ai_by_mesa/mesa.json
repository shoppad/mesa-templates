{
  "key": "shopify/product/generate_shopify_product_tags_with_ai_by_mesa",
  "name": "Use AI by MESA to generate Shopify product tags",
  "version": "1.0.0",
  "enabled": false,
  "setup": true,
  "config": {
    "inputs": [
      {
        "schema": 3,
        "trigger_type": "input",
        "type": "shopify",
        "version": "v2",
        "entity": "product",
        "action": "created",
        "name": "Product Created",
        "key": "shopify",
        "operation_id": "products_create",
        "metadata": {
          "frequency": "every",
          "includeFields": []
        },
        "local_fields": [],
        "selected_fields": [],
        "on_error": "default",
        "weight": 0
      }
    ],
    "outputs": [
      {
        "schema": 4,
        "trigger_type": "output",
        "type": "ai",
        "entity": "prompt",
        "action": "create",
        "name": "Prompt",
        "version": "v3",
        "key": "ai",
        "operation_id": "post-prompt",
        "metadata": {
          "api_endpoint": "post /prompt",
          "temperature": "1",
          "body": {
            "role": "user",
            "content": "Write 2 to 3 comma-separated tags using no more than 2 words for each based on the following product information:\nTitle: {{shopify.title}}\nDescription: {{shopify.body_html}} \nFormat the tags so they are comma separated, not numerically separated."
          }
        },
        "local_fields": [],
        "selected_fields": [],
        "on_error": "default",
        "weight": 0
      },
      {
        "schema": 3,
        "trigger_type": "output",
        "type": "shopify",
        "entity": "product",
        "action": "add",
        "name": "Product Add Tag",
        "version": "v2",
        "key": "shopify_1",
        "operation_id": "productTagsAdd",
        "metadata": {
          "api_endpoint": "post /graphql/productTags/add",
          "body": {
            "id": "{{shopify.id}}",
            "tags": "{{ai.response}}"
          }
        },
        "local_fields": [],
        "selected_fields": [
          "id",
          "tags",
          "body",
          "body.id",
          "body.tags"
        ],
        "on_error": "default",
        "weight": 1
      }
    ]
  }
}

{
    "key": "shopify/product/update_when_out_of_stock",
    "name": "Automatically Update Product Status When Variant Goes Out of Stock",
    "version": "1.0.0",
    "enabled": false,
    "setup": true,
    "config": {
        "inputs": [
            {
                "schema": 3,
                "trigger_type": "input",
                "type": "shopify",
                "version": "v2",
                "entity": "variant",
                "action": "out_of_stock",
                "name": "Variant Out of Stock",
                "key": "shopify",
                "operation_id": "variants_out_of_stock",
                "metadata": {
                    "frequency": "every",
                    "includeFields": []
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "product",
                "action": "retrieve",
                "name": "Retrieve Product",
                "version": "v2",
                "key": "shopify_1",
                "operation_id": "product",
                "metadata": {
                    "api_endpoint": "get /graphql/product/retrieve",
                    "body": {
                        "id": "{{shopify.product_id}}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "id",
                    "body",
                    "body.id"
                ],
                "on_error": "default",
                "weight": 0
            },
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "productvariant",
                "action": "list",
                "name": "Get List of Product Variants",
                "version": "v2",
                "key": "shopify_4",
                "operation_id": "productVariants",
                "metadata": {
                    "api_endpoint": "get /graphql/productVariants",
                    "body": {
                        "product_id": "{{shopify.product_id}}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "product_id",
                    "body",
                    "body.product_id"
                ],
                "on_error": "default",
                "weight": 1
            },
            {
                "schema": 5.1,
                "trigger_type": "output",
                "type": "loop",
                "entity": "count",
                "name": "Number of matches",
                "version": "v3",
                "key": "loop",
                "operation_id": "loop_count",
                "metadata": {
                    "key": "{{shopify_4}}",
                    "filter": {
                        "a": "{{shopify_4[].inventoryQuantity}}",
                        "comparison": "greater than",
                        "b": "0",
                        "additional": [
                            {
                                "operator": "and",
                                "comparison": "equals"
                            }
                        ]
                    }
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 2
            },
            {
                "schema": 4.1,
                "trigger_type": "output",
                "type": "filter",
                "name": "Filter",
                "key": "filter",
                "operation_id": "filter",
                "metadata": {
                    "a": "{{loop.count}}",
                    "comparison": "less than equal",
                    "b": "0",
                    "additional": [
                        {
                            "operator": "and",
                            "comparison": "equals"
                        }
                    ]
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 3
            },
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "product",
                "action": "update",
                "name": "Update Product",
                "version": "v2",
                "key": "shopify_2",
                "operation_id": "productUpdate",
                "metadata": {
                    "api_endpoint": "post /graphql/product/update",
                    "body": {
                        "id": "{{shopify_1.id}}",
                        "descriptionHtml": "{{shopify_1.descriptionHtml}} This product is currently out of stock, please check back soon!"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "id",
                    "descriptionHtml",
                    "body",
                    "body.id",
                    "body.descriptionHtml"
                ],
                "on_error": "default",
                "weight": 4
            },
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "publishable",
                "action": "unpublish",
                "name": "Unpublish Product or Collection",
                "version": "v2",
                "key": "shopify_3",
                "operation_id": "publishableUnpublish",
                "metadata": {
                    "api_endpoint": "post /graphql/publishable/unpublish",
                    "body": {
                        "type": "product",
                        "id": "{{shopify_1.id}}",
                        "input": [
                            {
                                "publicationId": "{{ template | label: 'What sales channel would you like to unpublish the product from?', placeholder: '', description: '', tokens: false }}"
                            }
                        ]
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "type",
                    "id",
                    "input",
                    "body",
                    "body.type",
                    "body.id",
                    "body.input"
                ],
                "on_error": "default",
                "weight": 5
            }
        ]
    }
}

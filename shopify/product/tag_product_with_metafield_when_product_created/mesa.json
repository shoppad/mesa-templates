{
    "key": "shopify/product/tag_product_with_metafield_when_product_created",
    "name": "Tag Shopify Products with Metafield Values",
    "version": "1.0.0",
    "enabled": false,
    "setup": true,
    "config": {
        "inputs": [
            {
                "schema": 3,
                "trigger_type": "input",
                "type": "shopify",
                "version": "v2",
                "entity": "product",
                "action": "created",
                "name": "Product Created",
                "key": "shopify",
                "operation_id": "products_create",
                "metadata": [],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 3,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "product",
                "action": "create",
                "name": "Retrieve Product Metafield",
                "version": "v2",
                "key": "shopify_1",
                "operation_id": "productMetafieldRetrieve",
                "metadata": {
                    "api_endpoint": "post /graphql/product/metafieldRetrieve",
                    "body": {
                        "productId": "{{shopify.id}}",
                        "namespace": "custom",
                        "key": "{{ template | label: 'What is the Key of your Product Metafield?', description: 'Go to the Settings page of your Shopify Admin. Click on Custom Data. View your product metafields and locate the key of the individual metafield.', tokens: false }}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "productId",
                    "namespace",
                    "key",
                    "body",
                    "body.productId",
                    "body.namespace",
                    "body.key"
                ],
                "on_error": "default",
                "weight": 0
            },
            {
                "schema": 3,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "product",
                "action": "add",
                "name": "Product Add Metafield Value Tag",
                "version": "v2",
                "key": "shopify_2",
                "operation_id": "productTagsAdd",
                "metadata": {
                    "api_endpoint": "post /graphql/productTags/add",
                    "body": {
                        "id": "{{shopify.id}}",
                        "tags": "{{shopify_1.value}}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "id",
                    "tags",
                    "body",
                    "body.id",
                    "body.tags"
                ],
                "on_error": "default",
                "weight": 1
            }
        ]
    }
}
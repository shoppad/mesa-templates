{
    "key": "shopify/product/search_and_discovery_metafields_kj",
    "name": "Boost Shopify Product Search Rankings Using Metafields in Search & Discovery",
    "version": "1.0.0",
    "enabled": false,
    "setup": false,
    "config": {
        "inputs": [
            {
                "schema": 3,
                "trigger_type": "input",
                "type": "shopify",
                "version": "v2",
                "entity": "product",
                "action": "updated",
                "name": "Product Updated",
                "key": "shopify",
                "operation_id": "products_update",
                "metadata": {
                    "frequency": "every",
                    "includeFields": []
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 3,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "product",
                "action": "create",
                "name": "Retrieve Product Metafield",
                "version": "v2",
                "key": "shopify_1",
                "operation_id": "productMetafieldRetrieve",
                "metadata": {
                    "api_endpoint": "post /graphql/product/metafieldRetrieve",
                    "body": {
                        "productId": "{{shopify.id}}",
                        "namespace": "custom",
                        "key": "boost_keywords"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "productId",
                    "namespace",
                    "key",
                    "body",
                    "body.productId",
                    "body.namespace",
                    "body.key"
                ],
                "on_error": "ignore",
                "weight": 0
            },
            {
                "schema": 4.1,
                "trigger_type": "output",
                "type": "filter",
                "name": "If Value Isn't Empty",
                "key": "filter",
                "metadata": {
                    "a": "{{shopify_1.value}}",
                    "comparison": "is not empty",
                    "additional": [
                        {
                            "operator": "and",
                            "comparison": "equals"
                        }
                    ],
                    "b": "0"
                },
                "local_fields": [],
                "selected_fields": ["a", "comparison", "additional"],
                "on_error": "default",
                "weight": 1
            },
            {
                "schema": 3,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "metafield",
                "action": "create",
                "name": "Retrieve Search Boost Metafield",
                "version": "v2",
                "key": "shopify_2",
                "operation_id": "metafieldQuery",
                "metadata": {
                    "api_endpoint": "post /graphql/metafield/query",
                    "body": {
                        "ownerType": "PRODUCT",
                        "ownerId": "{{shopify.id}}",
                        "namespace": "shopify--discovery--product_search_boost",
                        "key": "queries",
                        "limit": 1
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "ownerType",
                    "ownerId",
                    "namespace",
                    "key",
                    "limit",
                    "body",
                    "body.ownerType",
                    "body.ownerId",
                    "body.namespace",
                    "body.key",
                    "body.limit"
                ],
                "on_error": "default",
                "weight": 2
            },
            {
                "schema": 2,
                "trigger_type": "output",
                "type": "custom",
                "name": "Add New Value To List Of Boosts",
                "key": "custom",
                "metadata": {
                    "script": "custom.js",
                    "description": "Combine new boost values and existing boost values"
                },
                "local_fields": [],
                "selected_fields": ["script"],
                "on_error": "default",
                "weight": 3
            },
            {
                "schema": 3,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "product",
                "action": "create",
                "name": "Update Search Boost Metafield",
                "version": "v2",
                "key": "shopify_3",
                "operation_id": "productMetafieldSet",
                "metadata": {
                    "api_endpoint": "post /graphql/product/metafieldSet",
                    "body": {
                        "productId": "{{shopify.id}}",
                        "namespace": "shopify--discovery--product_search_boost",
                        "key": "queries",
                        "type": "list.single_line_text_field",
                        "value": "{{custom | json}}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "productId",
                    "namespace",
                    "key",
                    "type",
                    "value",
                    "body",
                    "body.productId",
                    "body.namespace",
                    "body.key",
                    "body.type",
                    "body.value"
                ],
                "on_error": "default",
                "weight": 4
            }
        ]
    }
}

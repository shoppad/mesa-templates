{
    "key": "shopify/product/slack_message_when_product_goes_out_of_stock",
    "name": "Receive Slack Notifications When a Shopify Product Goes Out of Stock",
    "version": "1.0.0",
    "enabled": false,
    "setup": true,
    "config": {
        "inputs": [
            {
                "schema": 2,
                "trigger_type": "input",
                "type": "shopify",
                "version": "v2",
                "entity": "order",
                "action": "created",
                "name": "Order Created",
                "key": "shopify",
                "operation_id": "orders_create",
                "metadata": [],
                "local_fields": [],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "shop",
                "action": "retrieve",
                "name": "Retrieve Shop",
                "version": "v2",
                "key": "shopify_1",
                "operation_id": "shop",
                "metadata": {
                    "api_endpoint": "get /graphql/shop/retrieve",
                    "body": {}
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 0
            },
            {
                "schema": 5,
                "trigger_type": "output",
                "type": "loop",
                "entity": "loop",
                "name": "Loop",
                "version": "v2",
                "key": "loop",
                "operation_id": "loop_loop",
                "metadata": {
                    "key": "{{shopify.line_items[]}}",
                    "filter": {
                        "comparison": "equals"
                    }
                },
                "local_fields": [],
                "on_error": "default",
                "weight": 1
            },
            {
                "schema": 3,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "productvariant",
                "action": "retrieve",
                "name": "Retrieve Product Variant",
                "version": "v2",
                "key": "shopify_2",
                "operation_id": "productVariant",
                "metadata": {
                    "api_endpoint": "get /graphql/productVariant/retrieve",
                    "body": {
                        "id": "{{loop.variant_id}}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "id",
                    "body",
                    "body.id"
                ],
                "on_error": "default",
                "weight": 2
            },
            {
                "schema": 2,
                "trigger_type": "output",
                "type": "filter",
                "name": "Filter",
                "key": "filter",
                "metadata": {
                    "a": "{{shopify_2.inventoryQuantity}}",
                    "comparison": "equals",
                    "b": "0",
                    "script": "filter.js"
                },
                "local_fields": [],
                "on_error": "default",
                "weight": 3
            },
            {
                "schema": 4,
                "trigger_type": "output",
                "type": "slack",
                "name": "Send Message",
                "version": "v2",
                "key": "slack",
                "metadata": {
                    "message": "This is an automated message to let you know that {% if shopify_2.sku != \"\" %}SKU *{{shopify_2.sku}}*{% else %}*{{loop.title}}*{% if shopify_2.selectedOptions[0].value != \"Default Title\" %} *- {{shopify_2.selectedOptions[0].value}}*{% endif %}{% endif %} is now out of stock.\n\nView the product: https://admin.shopify.com/store/{{shopify_1.myshopifyDomain | replace: \".myshopify.com\", \"\"}}/products/{{shopify_2.product.legacyResourceId}}",
                    "channel": "{{ template | label: 'What is your Slack channel?', tokens: false }}"
                },
                "local_fields": [],
                "on_error": "default",
                "weight": 4
            }
        ]
    }
}
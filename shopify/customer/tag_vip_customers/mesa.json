{
    "key": "shopify/customer/tag_vip_customers",
    "name": "Tag customers with \"VIP\" after they spend $500 or more",
    "version": "1.0.0",
    "seconds": 240,
    "enabled": false,
    "setup": true,
    "config": {
        "inputs": [
            {
                "schema": 2,
                "trigger_type": "input",
                "type": "shopify",
                "version": "v2",
                "entity": "order",
                "action": "created",
                "name": "Order Created",
                "key": "shopify_order",
                "operation_id": "orders_create",
                "metadata": [],
                "local_fields": [],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 3,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "customer",
                "action": "retrieve",
                "name": "Retrieve Customer",
                "version": "v2",
                "key": "shopify_customer_1",
                "operation_id": "customer",
                "metadata": {
                    "api_endpoint": "get /graphql/customer/retrieve",
                    "body": {
                        "id": "{{shopify_order.customer.id}}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "id",
                    "body",
                    "body.id"
                ],
                "on_error": "default",
                "weight": 0
            },
            {
                "schema": 2,
                "trigger_type": "output",
                "type": "filter",
                "name": "Filter",
                "key": "filter",
                "metadata": {
                    "a": "{{shopify_customer_1.amountSpent.amount}}",
                    "comparison": "greater than equal",
                    "b": "{{ template | label: 'How much does the customer need to spend?', description: 'The lifetime spending threshold in dollars. Customers who have spent more than this amount will be tagged as VIPs.', default: 500, type: 'number', tokens: false }}"
                },
                "local_fields": [],
                "on_error": "default",
                "weight": 1
            },
            {
                "schema": 3,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "customer",
                "action": "add",
                "name": "Customer Add Tag",
                "version": "v2",
                "key": "shopify_customer",
                "operation_id": "customerTagsAdd",
                "metadata": {
                    "api_endpoint": "post /graphql/customerTags/add",
                    "body": {
                        "id": "{{shopify_order.customer.id}}",
                        "tags": "{{ template | label: 'What tag should we use?', description: '', default: 'VIP', tokens: false }}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "id",
                    "tags",
                    "body",
                    "body.id",
                    "body.tags"
                ],
                "on_error": "default",
                "weight": 2
            }
        ]
    }
}
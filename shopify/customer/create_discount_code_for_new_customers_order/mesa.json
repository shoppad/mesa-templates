{
    "key": "shopify/customer/create_discount_code_for_new_customers_order",
    "name": "Create Unique Discount Codes for New Shopify Customers",
    "version": "1.0.0",
    "enabled": false,
    "setup": true,
    "config": {
        "inputs": [
            {
                "schema": 3,
                "trigger_type": "input",
                "type": "shopify",
                "version": "v2",
                "entity": "customer",
                "action": "created",
                "name": "Customer Created",
                "key": "shopify",
                "operation_id": "customers_create",
                "metadata": {
                    "frequency": "every",
                    "includeFields": []
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "discountcodebasic",
                "action": "create",
                "name": "Create Basic Discount Code",
                "version": "v2",
                "key": "shopify_1",
                "operation_id": "discountCodeBasicCreate",
                "metadata": {
                    "api_endpoint": "post /graphql/discountCodeBasic/create",
                    "body": {
                        "title": "NEWCUSTOMER {{shopify.id}} {{\"now\" | date: \"%Y-%m-%dT%H:%M:%S%z\"}}",
                        "code": "NEWCUSTOMER{{shopify.id}}",
                        "startsAt": "{{\"now\" | date: \"%Y-%m-%dT%H:%M:%S%z\"}}",
                        "endsAt": "{{ template | label: 'How long is the discount code valid?', description: 'It is set to 14 days (2 weeks) by default. Leave as is or update the date variable before continuing.', default: '{{\"now\" | date: \"%Y-%m-%dT%H:%M:%S%z\" | add_time: 14, \"days\" | date: \"%Y-%m-%dT%H:%M:%S%z\"}}' }}",
                        "appliesOncePerCustomer": true,
                        "context": {
                            "customers": {
                                "add": "{{shopify.id}}"
                            }
                        },
                        "customerGets": {
                            "items": {
                                "all": true
                            },
                            "value": {
                                "percentage": "{{ template | label: 'What percentage off should the discount give?', description: 'Enter the percentage as a decimal between 0 and 1. It is set to 0.2 (20% off) by default.', default: 0.2, type: 'number', tokens: false }}"
                            }
                        },
                        "minimumRequirement": {
                            "subtotal": {
                                "greaterThanOrEqualToSubtotal": "1.0"
                            }
                        }
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "title",
                    "code",
                    "startsAt",
                    "endsAt",
                    "appliesOncePerCustomer",
                    "context",
                    "customerGets",
                    "minimumRequirement",
                    "body",
                    "body.title",
                    "body.code",
                    "body.startsAt",
                    "body.endsAt",
                    "body.appliesOncePerCustomer",
                    "body.context",
                    "body.customerGets",
                    "body.minimumRequirement"
                ],
                "on_error": "default",
                "weight": 0
            },
            {
                "schema": 3,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "customer",
                "action": "add",
                "name": "Customer Add Tag",
                "version": "v2",
                "key": "shopify_4",
                "operation_id": "customerTagsAdd",
                "metadata": {
                    "api_endpoint": "post /graphql/customerTags/add",
                    "body": {
                        "id": "{{shopify.id}}",
                        "tags": "{{shopify_1.codeDiscount.code}}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "id",
                    "tags",
                    "body",
                    "body.id",
                    "body.tags"
                ],
                "on_error": "default",
                "weight": 1
            },
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "shop",
                "action": "retrieve",
                "name": "Retrieve Shop",
                "version": "v2",
                "key": "shopify_5",
                "operation_id": "shop",
                "metadata": {
                    "api_endpoint": "get /graphql/shop/retrieve",
                    "body": {}
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 2
            },
            {
                "schema": 4,
                "trigger_type": "output",
                "type": "filter",
                "name": "Filter",
                "key": "filter",
                "metadata": {
                    "a": "{{shopify.phone}}",
                    "comparison": "is not empty",
                    "additional": [
                        {
                            "operator": "and",
                            "comparison": "equals"
                        }
                    ]
                },
                "local_fields": [],
                "selected_fields": [
                    "a",
                    "comparison"
                ],
                "on_error": "default",
                "weight": 3
            },
            {
                "schema": 2,
                "trigger_type": "output",
                "type": "sms",
                "entity": "message",
                "action": "send",
                "name": "Send Message",
                "key": "sms",
                "operation_id": "message_send",
                "metadata": {
                    "to": "{{shopify.phone}}",
                    "message": "{{ template | label: 'Do you have any changes you''d like to make to the SMS message?', description: 'If you changed your discount, you''ll want to make sure that''s reflected here.', default: 'Thank you for shopping with {{shopify_5.name}}.\n\nTake 20% off your next order.\n\nUse online code: {{shopify_1.codeDiscount.code}}' }}"
                },
                "local_fields": [],
                "selected_fields": [
                    "to",
                    "message"
                ],
                "on_error": "default",
                "weight": 4
            }
        ]
    }
}
{
    "key": "shopify/checkout/send_abandoned_carts_to_google_sheets",
    "name": "Export Abandoned Carts to Google Sheets",
    "version": "1.0.0",
    "enabled": false,
    "setup": {
        "mode": "custom",
        "fields": [
            {
                "key": "create_spreadsheet_name",
                "target": "googlesheets_row.path.create_spreadsheet_name",
                "label": "What do you want to name your spreadsheet?",
                "tokens": false,
                "description": "Give your new Google Sheets spreadsheet a name."
            },
            {
                "key": "fields",
                "target": "googlesheets_row.setup_fields",
                "label": "What are your spreadsheet columns?",
                "description": "This template will automatically create a new row for every abandoned checkout. De-select the columns you do not want to include in your spreadsheet.",
                "options": [
                    {
                        "label": "Abandoned Cart ID",
                        "value": "Abandoned Cart ID|{{loop.id}}",
                        "description": "The ID of the abandoned cart."
                    },
                    {
                        "label": "Customer First Name",
                        "value": "Customer First Name|{{loop.customer.firstName}}",
                        "description": "The customer's first name."
                    },
                    {
                        "label": "Customer Last Name",
                        "value": "Customer Last Name|{{loop.customer.lastName}}",
                        "description": "The customer's last name."
                    },
                    {
                        "label": "Customer Phone Number",
                        "value": "Customer Phone Number|{{loop.customer.defaultPhoneNumber.phoneNumber}}",
                        "description": "The customer's phone number."
                    },
                    {
                        "label": "Total Cart Price",
                        "value": "Total Cart Price|{{loop.totalPriceSet.shopMoney.amount}}",
                        "description": "The total price of the abandoned cart."
                    },
                    {
                        "label": "Products",
                        "value": "Products|{% for line_item in loop.lineItems.nodes %} - {{line_item.title}} {% endfor %}",
                        "description": "The products included in the abandoned cart."
                    },
                    {
                        "label": "Abandoned Checkout URL",
                        "value": "Abandoned Checkout URL|{{loop.abandonedCheckoutUrl}}",
                        "description": "The recovery URL that's sent to a customer so they can recover their checkout."
                    }
                ],
                "check_all": true,
                "type": "checkboxes"
            }
        ]
    },
    "config": {
        "inputs": [
            {
                "schema": 2,
                "trigger_type": "input",
                "type": "schedule",
                "name": "Schedule",
                "key": "schedule",
                "metadata": {
                    "datetime": null,
                    "enqueue_type": "schedule",
                    "schedule": "{{ template | label: 'Select how frequently you want to schedule sending abandoned carts to Google Sheets' }}"
                },
                "local_fields": [],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 3,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "graphql",
                "action": "create",
                "name": "Get List of Abandoned Checkouts",
                "version": "v2",
                "key": "shopify",
                "operation_id": "graphqlQuery",
                "metadata": {
                    "api_endpoint": "post /graphql/graphql/query",
                    "body": {
                        "query": "query AbandonedCheckouts($query: String) {\n  abandonedCheckouts(first: 250, query: $query) {\n    nodes {\n      id\n      name\n      completedAt\n      abandonedCheckoutUrl\n      totalPriceSet {\n        shopMoney {\n          amount\n        }\n      }\n      customer {\n        firstName\n        lastName\n        defaultPhoneNumber {\n          phoneNumber\n        }\n      }\n      lineItems(first: 50) {\n        nodes {\n          title\n        }\n      }\n    }\n  }\n}",
                        "variables": "{\"query\": \"created_at:>'{{'now' | date: '%Y-%m-%dT%H:%M:%S%z' | subtract_time: 1, 'hours' | date: '%Y-%m-%dT%H:%M:%S%z'}}'\"}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "query",
                    "variables",
                    "body",
                    "body.query",
                    "body.variables"
                ],
                "on_error": "default",
                "weight": 0
            },
            {
                "schema": 4,
                "trigger_type": "output",
                "type": "filter",
                "name": "Filter: Check for abandoned carts",
                "key": "filter",
                "metadata": {
                    "a": "{{shopify.abandonedCheckouts.nodes[0].id}}",
                    "comparison": "is not empty"
                },
                "local_fields": [],
                "on_error": "default",
                "weight": 1
            },
            {
                "schema": 5,
                "trigger_type": "output",
                "type": "loop",
                "version": "v2",
                "entity": "loop",
                "operation_id": "loop_loop",
                "name": "Loop",
                "key": "loop",
                "metadata": {
                    "key": "{{shopify.abandonedCheckouts.nodes}}"
                },
                "local_fields": [],
                "on_error": "default",
                "weight": 2
            },
            {
                "schema": 4,
                "trigger_type": "output",
                "type": "filter",
                "name": "Filter: Check if abandoned cart is still not recovered",
                "key": "filter_1",
                "metadata": {
                    "a": "{{loop.completedAt}}",
                    "comparison": "is empty"
                },
                "local_fields": [],
                "on_error": "default",
                "weight": 3
            },
            {
                "schema": 4,
                "trigger_type": "output",
                "type": "googlesheets",
                "entity": "row",
                "action": "create",
                "name": "Create Row",
                "key": "googlesheets_row",
                "version": "v2",
                "operation_id": "record_create",
                "metadata": {
                    "path": {
                        "spreadsheet_id": "",
                        "sheet_name": "Sheet1"
                    },
                    "body": {
                        "fields": {}
                    }
                },
                "on_error": "replay",
                "weight": 4
            }
        ]
    }
}

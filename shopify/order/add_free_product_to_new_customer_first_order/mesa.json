{
    "key": "shopify/order/add_free_product_to_new_customer_first_order",
    "name": "Add a Free Product to First Time Customer's Order",
    "version": "1.0.0",
    "enabled": false,
    "logging": false,
    "debug": false,
    "setup": true,
    "config": {
        "inputs": [
            {
                "schema": 2,
                "trigger_type": "input",
                "type": "shopify",
                "version": "v2",
                "entity": "order",
                "action": "created",
                "name": "Order Created",
                "key": "shopify_order",
                "operation_id": "orders_create",
                "metadata": [],
                "local_fields": [],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 3,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "customer",
                "action": "retrieve",
                "name": "Retrieve Customer",
                "version": "v2",
                "key": "shopify_customer",
                "operation_id": "customer",
                "metadata": {
                    "api_endpoint": "get /graphql/customer/retrieve",
                    "body": {
                        "id": "{{shopify_order.customer.id}}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "id",
                    "body",
                    "body.id"
                ],
                "on_error": "default",
                "weight": 0
            },
            {
                "schema": 2,
                "trigger_type": "output",
                "type": "filter",
                "name": "Filter",
                "key": "filter",
                "metadata": {
                    "a": "{{shopify_customer.numberOfOrders}}",
                    "comparison": "equals",
                    "b": "1"
                },
                "local_fields": [],
                "on_error": "default",
                "weight": 1
            },
            {
                "schema": 3,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "order",
                "action": "create",
                "name": "Add Free Line Item to Order",
                "version": "v2",
                "key": "shopify_order_1",
                "operation_id": "post_mesa_orders_order_id_add-line-item",
                "metadata": {
                    "api_endpoint": "post /graphql/order/addLineItem",
                    "body": {
                        "id": "{{shopify_order.id}}",
                        "productId": "{{ template | label: 'Select your free product', description: 'Select the product to add as a free line item. In the next step you will select the variant you would like to use.', placeholder: '', weight: 0}}",
                        "variantId": "{{ template | label: 'Select the variant of the free product', description: 'If your product only has one variant, click Next.', placeholder: '', weight: 0}}",
                        "discountType": "Percentage",
                        "discountAmount": "100",
                        "allowDuplicates": true,
                        "notifyCustomer": false,
                        "orderNote": "Add free product",
                        "quantity": "1"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "id",
                    "productId",
                    "variantId",
                    "discountType",
                    "discountAmount",
                    "allowDuplicates",
                    "notifyCustomer",
                    "orderNote",
                    "quantity",
                    "body",
                    "body.id",
                    "body.productId",
                    "body.variantId",
                    "body.discountType",
                    "body.discountAmount",
                    "body.allowDuplicates",
                    "body.notifyCustomer",
                    "body.orderNote",
                    "body.quantity"
                ],
                "on_error": "default",
                "weight": 2
            }
        ],
        "storage": []
    }
}
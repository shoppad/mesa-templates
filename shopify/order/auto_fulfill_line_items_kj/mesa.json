{
    "key": "shopify/order/auto_fulfill_line_items_kj",
    "name": "Automatically Fulfill Shopify Line Items by SKU",
    "version": "1.0.0",
    "enabled": false,
    "setup": true,
    "config": {
        "inputs": [
            {
                "schema": 3,
                "trigger_type": "input",
                "type": "shopify",
                "version": "v2",
                "entity": "order",
                "action": "created",
                "name": "Order Created",
                "key": "shopify",
                "operation_id": "orders_create",
                "metadata": {
                    "frequency": "every",
                    "includeFields": []
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 3,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "graphql",
                "action": "create",
                "name": "Get Fulfillment Orders",
                "version": "v2",
                "key": "shopify_2",
                "operation_id": "graphqlQuery",
                "metadata": {
                    "api_endpoint": "post /graphql/graphql/query",
                    "body": {
                        "query": "query OrderFulfillmentOrders($id: ID!) {\n  order(id: $id) {\n    fulfillmentOrders(first: 20, query: \"status:open OR status:in_progress\") {\n      nodes {\n        id\n        lineItems(first: 100) {\n          nodes {\n            id\n            remainingQuantity\n            requiresShipping\n            sku\n            lineItem {\n              id\n            }\n          }\n        }\n      }\n    }\n  }\n}",
                        "variables": "{\"id\": \"gid://shopify/Order/{{shopify.id}}\"}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "query",
                    "variables",
                    "body",
                    "body.query",
                    "body.variables"
                ],
                "on_error": "default",
                "weight": 0
            },
            {
                "schema": 2,
                "trigger_type": "output",
                "type": "custom",
                "name": "List Fulfillment Order Line Items",
                "key": "custom",
                "metadata": {
                    "script": "custom.js"
                },
                "local_fields": [],
                "on_error": "default",
                "weight": 1
            },
            {
                "schema": 5.1,
                "trigger_type": "output",
                "type": "loop",
                "entity": "loop",
                "name": "Loop Over Line Items",
                "version": "v3",
                "key": "loop",
                "operation_id": "loop_loop",
                "metadata": {
                    "key": "{{custom.line_items[]}}",
                    "filter": {
                        "comparison": "equals",
                        "additional": [
                            {
                                "operator": "and",
                                "comparison": "equals"
                            }
                        ]
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "key",
                    "filter",
                    "filter.a",
                    "filter.comparison",
                    "filter.b"
                ],
                "on_error": "default",
                "weight": 2
            },
            {
                "schema": 4.1,
                "trigger_type": "output",
                "type": "filter",
                "name": "Is It The Auto-Fulfillable SKU?",
                "key": "filter",
                "operation_id": "filter",
                "metadata": {
                    "trigger_parent_key": "loop",
                    "a": "{{loop.sku}}",
                    "comparison": "equals",
                    "b": "{{ template | label: 'The SKU you want to auto-fulfill' }}",
                    "additional": [
                        {
                            "operator": "and",
                            "comparison": "equals"
                        }
                    ]
                },
                "local_fields": [],
                "selected_fields": [
                    "a",
                    "comparison",
                    "b",
                    "additional",
                    "additional[].operator",
                    "additional[].a",
                    "additional[].comparison",
                    "additional[].b"
                ],
                "on_error": "default",
                "weight": 3
            },
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "fulfillment",
                "action": "create",
                "name": "Create Order Fulfillment",
                "version": "v2",
                "key": "shopify_1",
                "operation_id": "fulfillmentCreate",
                "metadata": {
                    "api_endpoint": "post /graphql/fulfillment/create",
                    "body": {
                        "fulfillmentOrderId": "{{loop.fulfillment_order_id}}",
                        "fulfillmentOrderLineItems": [
                            {
                                "id": "{{loop.id}}",
                                "quantity": "{{loop.quantity}}"
                            }
                        ]
                    },
                    "trigger_parent_key": "loop"
                },
                "local_fields": [],
                "selected_fields": [
                    "fulfillmentOrderId",
                    "fulfillmentOrderLineItems",
                    "body",
                    "body.fulfillmentOrderId",
                    "body.fulfillmentOrderLineItems",
                    "body.fulfillmentOrderLineItems[].id",
                    "body.fulfillmentOrderLineItems[].quantity"
                ],
                "on_error": "default",
                "weight": 4
            },
            {
                "schema": 5.1,
                "trigger_type": "output",
                "type": "loop",
                "entity": "end",
                "name": "Loop End",
                "version": "v3",
                "key": "loop_1",
                "operation_id": "loop_end",
                "metadata": {
                    "trigger_manager_key": "loop",
                    "trigger_parent_key": "loop"
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 5
            }
        ]
    }
}

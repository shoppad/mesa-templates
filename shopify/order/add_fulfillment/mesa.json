{
    "key": "shopify/order/add_fulfillment",
    "name": "Add fulfillment to line items that don't require shipping",
    "version": "1.0.0",
    "enabled": false,
    "setup": true,
    "config": {
        "inputs": [
            {
                "schema": 3,
                "trigger_type": "input",
                "type": "shopify",
                "version": "v2",
                "entity": "order",
                "action": "created",
                "name": "Order Created",
                "key": "shopify_order",
                "operation_id": "orders_create",
                "metadata": [],
                "local_fields": [],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 3,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "graphql",
                "action": "create",
                "name": "Get Fulfillment Orders",
                "version": "v2",
                "key": "shopify_order_fulfillment_orders",
                "operation_id": "graphqlQuery",
                "metadata": {
                    "api_endpoint": "post /graphql/graphql/query",
                    "body": {
                        "query": "query OrderFulfillmentOrders($id: ID!) {\n  order(id: $id) {\n    fulfillmentOrders(first: 20, query: \"status:open OR status:in_progress\") {\n      nodes {\n        id\n        lineItems(first: 100) {\n          nodes {\n            id\n            remainingQuantity\n            requiresShipping\n            sku\n            lineItem {\n              id\n            }\n          }\n        }\n      }\n    }\n  }\n}",
                        "variables": "{\"id\": \"gid://shopify/Order/{{shopify_order.id}}\"}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "query",
                    "variables",
                    "body",
                    "body.query",
                    "body.variables"
                ],
                "on_error": "default",
                "weight": 0
            },
            {
                "schema": 2,
                "trigger_type": "output",
                "type": "custom",
                "name": "List Fulfillment Order Line Items",
                "key": "custom",
                "metadata": {
                    "script": "custom.js"
                },
                "local_fields": [],
                "on_error": "default",
                "weight": 1
            },
            {
                "schema": 5,
                "trigger_type": "output",
                "type": "loop",
                "entity": "loop",
                "name": "Loop",
                "version": "v2",
                "key": "loop",
                "operation_id": "loop_loop",
                "metadata": {
                    "key": "{{custom.line_items[]}}",
                    "filter": {
                        "comparison": "equals"
                    }
                },
                "local_fields": [],
                "on_error": "default",
                "weight": 2
            },
            {
                "schema": 4,
                "trigger_type": "output",
                "type": "filter",
                "name": "Filter",
                "key": "filter",
                "metadata": {
                    "a": "{{loop.requires_shipping}}",
                    "comparison": "equals",
                    "b": "false"
                },
                "local_fields": [],
                "on_error": "default",
                "weight": 3
            },
            {
                "schema": 3,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "fulfillment",
                "action": "create",
                "name": "Create Order Fulfillment",
                "version": "v2",
                "key": "shopify_order_fulfillment",
                "operation_id": "fulfillmentCreate",
                "metadata": {
                    "api_endpoint": "post /graphql/fulfillment/create",
                    "body": {
                        "fulfillmentOrderId": "{{loop.fulfillment_order_id}}",
                        "fulfillmentOrderLineItems": [
                            {
                                "id": "{{loop.id}}",
                                "quantity": "{{loop.quantity}}"
                            }
                        ],
                        "notifyCustomer": false
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "fulfillmentOrderId",
                    "fulfillmentOrderLineItems",
                    "notifyCustomer",
                    "body",
                    "body.fulfillmentOrderId",
                    "body.fulfillmentOrderLineItems",
                    "body.notifyCustomer"
                ],
                "on_error": "default",
                "weight": 4
            }
        ]
    }
}

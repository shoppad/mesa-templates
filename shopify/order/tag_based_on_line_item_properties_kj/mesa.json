{
    "key": "shopify/order/tag_based_on_line_item_properties_kj",
    "name": "Tag Shopify Orders by Line Item Properties",
    "version": "1.0.0",
    "enabled": false,
    "setup": true,
    "config": {
        "inputs": [
            {
                "schema": 3,
                "trigger_type": "input",
                "type": "shopify",
                "entity": "order",
                "action": "created",
                "name": "Order Created",
                "version": "v2",
                "key": "shopify",
                "operation_id": "orders_create",
                "metadata": {
                    "frequency": "every",
                    "includeFields": []
                },
                "local_fields": [],
                "selected_fields": [
                    "frequency"
                ],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 5.1,
                "trigger_type": "output",
                "type": "loop",
                "entity": "loop",
                "name": "Loop",
                "version": "v3",
                "key": "loop",
                "operation_id": "loop_loop",
                "metadata": {
                    "key": "{{shopify.line_items[]}}",
                    "return": false,
                    "filter": {
                        "comparison": "equals",
                        "additional": [
                            {
                                "operator": "and",
                                "comparison": "equals"
                            }
                        ]
                    }
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 0
            },
            {
                "schema": 5.1,
                "trigger_type": "output",
                "type": "loop",
                "entity": "loop",
                "name": "Loop",
                "version": "v3",
                "key": "loop_2",
                "operation_id": "loop_loop",
                "metadata": {
                    "trigger_parent_key": "loop",
                    "key": "{{loop.properties[]}}",
                    "return": false,
                    "filter": {
                        "a": "{{loop.properties[].name}}",
                        "comparison": "equals",
                        "b": "{{ template | label: 'The name of the line item variable?', tokens: false }}",
                        "additional": [
                            {
                                "operator": "and",
                                "a": "{{loop.properties[].value}}",
                                "comparison": "equals",
                                "b": "{{ template | label: 'The value for the line item variable?', tokens: false }}"
                            }
                        ]
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "filter.a",
                    "filter.comparison",
                    "filter.b",
                    "filter.additional[].operator",
                    "filter.additional[].a",
                    "filter.additional[].comparison",
                    "filter.additional[].b",
                    "filter.additional",
                    "filter",
                    "filter.additional[]"
                ],
                "on_error": "default",
                "weight": 1
            },
            {
                "schema": 4,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "order",
                "action": "add",
                "name": "Add Order Tags",
                "version": "v2",
                "key": "shopify_1",
                "operation_id": "orderTagsAdd",
                "metadata": {
                    "api_endpoint": "post \/graphql\/orderTags\/add",
                    "body": {
                        "id": "{{shopify.id}}",
                        "tags": [
                            "{{ template | label: 'The tag you want to use?', tokens: false }}"
                        ]
                    },
                    "trigger_parent_key": "loop_2"
                },
                "local_fields": [],
                "selected_fields": [
                    "body"
                ],
                "on_error": "default",
                "weight": 2
            },
            {
                "schema": 5.1,
                "trigger_type": "output",
                "type": "loop",
                "entity": "end",
                "name": "Loop End",
                "version": "v3",
                "key": "loop_3",
                "operation_id": "loop_end",
                "metadata": {
                    "trigger_manager_key": "loop_2",
                    "trigger_parent_key": "loop_2",
                    "return": false
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 3
            },
            {
                "schema": 5.1,
                "trigger_type": "output",
                "type": "loop",
                "entity": "end",
                "name": "Loop End",
                "version": "v3",
                "key": "loop_1",
                "operation_id": "loop_end",
                "metadata": {
                    "trigger_manager_key": "loop",
                    "trigger_parent_key": "loop",
                    "return": false
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 4
            }
        ]
    }
}
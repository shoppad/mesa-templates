{
    "key": "add_product_tag",
    "name": "Copy Product Tags to the Order When a New Order is Created",
    "version": "1.0.0",
    "description": "To fulfill an order correctly, it’s helpful to note the product tags to make sure you’re shipping the correct item. Instead of manually copying each product tag by yourself, Mesa does everything for you each time by doing the time-consuming task when a new order is created. That’s extra time you’ll save to focus on more critical tasks.",
    "video": "",
    "readme": "",
    "tags": [],
    "source": "shopify",
    "destination": "shopify",
    "enabled": false,
    "logging": false,
    "debug": false,
    "setup": true,
    "config": {
        "inputs": [
            {
                "schema": 3,
                "trigger_type": "input",
                "type": "shopify",
                "version": "v2",
                "entity": "order",
                "action": "created",
                "name": "Order Created",
                "key": "shopify_order",
                "operation_id": "orders_create",
                "metadata": [],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 5,
                "trigger_type": "output",
                "type": "loop",
                "version": "v2",
                "entity": "loop",
                "operation_id": "loop_loop",
                "name": "Loop",
                "key": "loop",
                "metadata": {
                    "key": "{{shopify_order.line_items[]}}"
                },
                "local_fields": [],
                "on_error": "default",
                "weight": 0
            },
            {
                "schema": 3,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "product",
                "action": "retrieve",
                "name": "Retrieve Product",
                "version": "v2",
                "key": "shopify_product",
                "operation_id": "product",
                "metadata": {
                    "api_endpoint": "get /graphql/product/retrieve",
                    "body": {
                        "id": "{{loop.product_id}}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "id",
                    "body",
                    "body.id"
                ],
                "on_error": "default",
                "weight": 1
            },
            {
                "schema": 3,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "order",
                "action": "retrieve",
                "name": "Retrieve Order",
                "version": "v2",
                "key": "shopify_order_2",
                "operation_id": "order",
                "metadata": {
                    "api_endpoint": "get /graphql/order/retrieve",
                    "body": {
                        "id": "{{shopify_order.id}}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "id",
                    "body",
                    "body.id"
                ],
                "on_error": "default",
                "weight": 2
            },
            {
                "schema": 3,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "order",
                "action": "update",
                "name": "Update Order",
                "version": "v2",
                "key": "shopify_order_1",
                "operation_id": "orderUpdate",
                "metadata": {
                    "api_endpoint": "post /graphql/order/update",
                    "body": {
                        "id": "{{shopify_order.id}}",
                        "tags": "{{shopify_order_2.tags | join: \", \"}}, {{shopify_product.tags | join: \", \"}}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "id",
                    "tags",
                    "body",
                    "body.id",
                    "body.tags"
                ],
                "on_error": "default",
                "weight": 3
            }
        ],
        "storage": []
    }
}
{
    "key": "shopify/order/send_to_another_shopify_store",
    "name": "Send Orders From One Shopify Store To Another",
    "version": "1.0.0",
    "enabled": false,
    "setup": false,
    "config": {
        "inputs": [
            {
                "schema": 3,
                "trigger_type": "input",
                "type": "shopify",
                "version": "v2",
                "entity": "order",
                "action": "created",
                "name": "Order Created",
                "key": "shopify",
                "operation_id": "orders_create",
                "metadata": {
                    "frequency": "every",
                    "includeFields": []
                },
                "local_fields": [],
                "selected_fields": ["frequency"],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "order",
                "action": "create",
                "name": "Create Order",
                "version": "v2",
                "key": "shopify_1",
                "operation_id": "orderCreate",
                "metadata": {
                    "api_endpoint": "post /graphql/order/create",
                    "body": {
                        "currency": "{{shopify.currency}}",
                        "presentmentCurrency": "{{shopify.presentment_currency}}",
                        "email": "{{shopify.email}}",
                        "name": "{{shopify.name}}",
                        "note": "{{shopify.note}}",
                        "sourceIdentifier": "{{shopify.source_identifier}}",
                        "tags": "Imported order, {{shopify.tags}}",
                        "taxesIncluded": "{{shopify.taxes_included}}",
                        "inventoryBehaviour": "BYPASS",
                        "lineItems": [
                            {
                                "title": "{{shopify.line_items[].title}}",
                                "variantTitle": "{{shopify.line_items[].variant_title}}",
                                "sku": "{{shopify.line_items[].sku}}",
                                "quantity": "{{shopify.line_items[].quantity}}",
                                "priceSet": {
                                    "shopMoney": {
                                        "amount": "{{shopify.line_items[].price}}",
                                        "currencyCode": "{{shopify.currency}}"
                                    }
                                },
                                "properties": [
                                    {
                                        "name": "{{shopify.line_items[].properties[].name}}",
                                        "value": "{{shopify.line_items[].properties[].value}}"
                                    }
                                ]
                            }
                        ],
                        "shippingLines": [
                            {
                                "title": "{{shopify.shipping_lines[].title}}",
                                "priceSet": {
                                    "shopMoney": {
                                        "amount": "{{shopify.shipping_lines[].discounted_price}}",
                                        "currencyCode": "{{shopify.currency}}"
                                    }
                                }
                            }
                        ],
                        "billingAddress": {
                            "firstName": "{{shopify.billing_address.first_name}}",
                            "lastName": "{{shopify.billing_address.last_name}}",
                            "company": "{{shopify.billing_address.company}}",
                            "address1": "{{shopify.billing_address.address1}}",
                            "address2": "{{shopify.billing_address.address2}}",
                            "city": "{{shopify.billing_address.city}}",
                            "provinceCode": "{{shopify.billing_address.province_code}}",
                            "countryCode": "{{shopify.billing_address.country_code}}",
                            "zip": "{{shopify.billing_address.zip}}",
                            "phone": "{{shopify.billing_address.phone}}"
                        },
                        "shippingAddress": {
                            "firstName": "{{shopify.shipping_address.first_name}}",
                            "lastName": "{{shopify.shipping_address.last_name}}",
                            "company": "{{shopify.shipping_address.company}}",
                            "address1": "{{shopify.shipping_address.address1}}",
                            "address2": "{{shopify.shipping_address.address2}}",
                            "city": "{{shopify.shipping_address.city}}",
                            "provinceCode": "{{shopify.shipping_address.province_code}}",
                            "countryCode": "{{shopify.shipping_address.country_code}}",
                            "zip": "{{shopify.shipping_address.zip}}",
                            "phone": "{{shopify.shipping_address.phone}}"
                        },
                        "customer": {
                            "toUpsert": {
                                "email": "{{shopify.customer.email}}",
                                "firstName": "{{shopify.customer.first_name}}",
                                "lastName": "{{shopify.customer.last_name}}",
                                "note": "{{shopify.customer.note}}"
                            }
                        }
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "currency",
                    "presentmentCurrency",
                    "email",
                    "name",
                    "note",
                    "sourceIdentifier",
                    "tags",
                    "taxesIncluded",
                    "inventoryBehaviour",
                    "lineItems",
                    "shippingLines",
                    "billingAddress",
                    "shippingAddress",
                    "customer",
                    "body",
                    "body.currency",
                    "body.presentmentCurrency",
                    "body.email",
                    "body.name",
                    "body.note",
                    "body.sourceIdentifier",
                    "body.tags",
                    "body.taxesIncluded",
                    "body.inventoryBehaviour",
                    "body.lineItems",
                    "body.shippingLines",
                    "body.billingAddress",
                    "body.shippingAddress",
                    "body.customer"
                ],
                "on_error": "default",
                "weight": 0
            }
        ]
    }
}

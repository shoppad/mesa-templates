{
    "key": "shopify/order/tag_unfulfilled_orders_after_time",
    "name": "Tag Shopify Orders if Unfulfilled After Set Time",
    "version": "1.0.0",
    "enabled": false,
    "setup": true,
    "config": {
        "inputs": [
            {
                "schema": 3,
                "trigger_type": "input",
                "type": "shopify",
                "version": "v2",
                "entity": "order",
                "action": "created",
                "name": "Order Created",
                "key": "shopify",
                "operation_id": "orders_create",
                "metadata": {
                    "frequency": "every",
                    "includeFields": []
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 2,
                "trigger_type": "output",
                "type": "delay",
                "name": "Delay",
                "version": "v2",
                "key": "delay",
                "operation_id": "delay",
                "metadata": {
                    "amount": "{{ template | label: 'How long should MESA wait after the order is created before checking its fulfillment status?', description: '', default: 10, type: 'number', tokens: false }}",
                    "unit": "days",
                    "test_bypass": false
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 0
            },
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "order",
                "action": "retrieve",
                "name": "Retrieve Order",
                "version": "v2",
                "key": "shopify_1",
                "operation_id": "order",
                "metadata": {
                    "api_endpoint": "get /graphql/order/retrieve",
                    "body": {
                        "id": "{{shopify.id}}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "id",
                    "body",
                    "body.id"
                ],
                "on_error": "default",
                "weight": 1
            },
            {
                "schema": 4.1,
                "trigger_type": "output",
                "type": "filter",
                "name": "Filter",
                "key": "filter",
                "operation_id": "filter",
                "metadata": {
                    "a": "{{shopify_1.displayFulfillmentStatus}}",
                    "comparison": "does not equal",
                    "b": "FULFILLED",
                    "additional": [
                        {
                            "operator": "and",
                            "comparison": "equals"
                        }
                    ]
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 2
            },
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "order",
                "action": "add",
                "name": "Order Add Tag",
                "version": "v2",
                "key": "shopify_2",
                "operation_id": "orderTagsAdd",
                "metadata": {
                    "api_endpoint": "post /graphql/orderTags/add",
                    "body": {
                        "id": "{{shopify.id}}",
                        "tags": "{{ template | label: 'What tag should MESA add to the order if it''s still unfulfilled?', description: 'This tag helps you identify orders that haven''t been fulfilled after the waiting period. (Default: Unfulfilled).', default: 'Unfulfilled', tokens: false }}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "id",
                    "tags",
                    "body",
                    "body.id",
                    "body.tags"
                ],
                "on_error": "default",
                "weight": 3
            }
        ]
    }
}

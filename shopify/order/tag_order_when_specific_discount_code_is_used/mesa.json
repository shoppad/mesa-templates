{
    "key": "shopify/order/tag_order_when_specific_discount_code_is_used",
    "name": "Tag an order when a specific discount code is applied",
    "version": "1.0.0",
    "enabled": false,
    "setup": true,
    "config": {
        "inputs": [
            {
                "schema": 3,
                "trigger_type": "input",
                "type": "shopify",
                "version": "v2",
                "entity": "order",
                "action": "created",
                "name": "Order Created",
                "key": "shopify",
                "operation_id": "orders_create",
                "metadata": {
                    "frequency": "every",
                    "includeFields": []
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 5.1,
                "trigger_type": "output",
                "type": "loop",
                "entity": "loop",
                "name": "Loop",
                "version": "v2",
                "key": "loop",
                "operation_id": "loop_loop",
                "metadata": {
                    "key": "{{shopify.discount_codes[]}}",
                    "filter": {
                        "a": "{{shopify.discount_codes[].code}}",
                        "comparison": "equals",
                        "b": "{{ template | label: 'What is the specific discount code customers will use?', tokens: false }}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "filter.a",
                    "filter.comparison",
                    "filter.b"
                ],
                "on_error": "default",
                "weight": 0
            },
            {
                "schema": 3,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "order",
                "action": "add",
                "name": "Order Add Tag",
                "version": "v2",
                "key": "shopify_1",
                "operation_id": "orderTagsAdd",
                "metadata": {
                    "api_endpoint": "post /graphql/orderTags/add",
                    "body": {
                        "id": "{{shopify.id}}",
                        "tags": "{{ template | label: 'What is the tag that will be added to orders?', tokens: false }}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "id",
                    "tags",
                    "body",
                    "body.id",
                    "body.tags"
                ],
                "on_error": "default",
                "weight": 1
            }
        ]
    }
}
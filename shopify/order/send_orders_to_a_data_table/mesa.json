{
    "key": "shopify/order/send_orders_to_a_data_table",
    "name": "Save Shopify Orders to a Database",
    "version": "1.0.0",
    "enabled": false,
    "setup": true,
    "config": {
        "inputs": [
            {
                "schema": 3,
                "trigger_type": "input",
                "type": "shopify",
                "entity": "order",
                "action": "created",
                "name": "Order Created",
                "version": "v2",
                "key": "shopify",
                "operation_id": "orders_create",
                "metadata": {
                    "frequency": "every",
                    "includeFields": []
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 4,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "shop",
                "action": "retrieve",
                "name": "Retrieve Shop",
                "version": "v2",
                "key": "shopify_2",
                "operation_id": "shop",
                "metadata": {
                    "api_endpoint": "get \/graphql\/shop\/retrieve"
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 0
            },
            {
                "schema": 5.1,
                "trigger_type": "output",
                "type": "loop",
                "entity": "loop",
                "name": "Loop Over Products In Order",
                "version": "v3",
                "key": "loop",
                "operation_id": "loop_loop",
                "metadata": {
                    "key": "{{shopify.line_items[]}}",
                    "return": false
                },
                "local_fields": [],
                "selected_fields": ["key"],
                "on_error": "default",
                "weight": 1
            },
            {
                "schema": 4,
                "trigger_type": "output",
                "type": "data",
                "entity": "record",
                "action": "create",
                "name": "Create Record",
                "version": "v2",
                "key": "data",
                "operation_id": "post_database_table",
                "metadata": {
                    "api_endpoint": "post \/{database}\/{table}",
                    "trigger_parent_key": "loop",
                    "create": "existing",
                    "columns": {
                        "Order Name": "{{shopify.name}}",
                        "Order ID": "{{shopify.id}}",
                        "Order Created At": "{{shopify.created_at}}",
                        "Order Updated At": "{{shopify.updated_at}}",
                        "Order Admin URL": " https:\/\/admin.shopify.com\/store\/{{shopify_2.myshopifyDomain | replace: \".myshopify.com\", \"\"}}\/orders\/{{shopify.id}}",
                        "Customer": "{{shopify.customer.first_name}} {{shopify.customer.last_name}}",
                        "Customer Email": "{{shopify.email}}",
                        "Shipping Address 1": "{{shopify.shipping_address.address1}}",
                        "Shipping Address 2": "{{shopify.shipping_address.address2}}",
                        "Shipping City": "{{shopify.shipping_address.city}}",
                        "Shipping State\/Province": "{{shopify.shipping_address.province}}",
                        "Shipping Zip\/Postal Code": "{{shopify.shipping_address.zip}}",
                        "Shipping Country": "{{shopify.shipping_address.country}}",
                        "Product Title": "{{loop.title}}",
                        "Product ID": "{{loop.product_id}}",
                        "Product Line Item ID": "{{loop.id}}",
                        "Product SKU": "{{loop.sku}}",
                        "Product Vendor": "{{loop.vendor}}",
                        "Product Quantity": "{{loop.quantity}}",
                        "Product Price": "{{loop.price}}"
                    },
                    "table": "Shopify Orders"
                },

{
    "key": "shopify/inventory/get_discord_alerts_with_stock_update",
    "name": "Get Discord Notifications for Shopify Inventory Updates",
    "version": "1.0.0",
    "enabled": false,
    "setup": true,
    "config": {
        "inputs": [
            {
                "schema": 3,
                "trigger_type": "input",
                "type": "shopify",
                "version": "v2",
                "entity": "inventory_level",
                "action": "updated",
                "name": "Inventory Level Updated",
                "key": "shopify",
                "operation_id": "inventory_levels_update",
                "metadata": {
                    "frequency": "every",
                    "includeFields": []
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "shop",
                "action": "retrieve",
                "name": "Retrieve Shop",
                "version": "v2",
                "key": "shopify_1",
                "operation_id": "shop",
                "metadata": {
                    "api_endpoint": "get /graphql/shop/retrieve",
                    "body": {}
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 0
            },
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "product",
                "action": "retrieve",
                "name": "Retrieve Product",
                "version": "v2",
                "key": "shopify_2",
                "operation_id": "product",
                "metadata": {
                    "api_endpoint": "get /graphql/product/retrieve",
                    "body": {
                        "id": "{{shopify.variant.product_id}}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "id",
                    "body",
                    "body.id"
                ],
                "on_error": "default",
                "weight": 1
            },
            {
                "schema": 4,
                "trigger_type": "output",
                "type": "discord",
                "entity": "channel_message",
                "action": "create",
                "name": "Create Channel Message",
                "key": "discord",
                "operation_id": "post-channels-channelId-messages",
                "metadata": {
                    "api_endpoint": "post /channels/{channelId}/messages",
                    "path": {
                        "channelId": "{{ template | label: 'What is your Discord''s Channel ID?', description: '', tokens: false }}"
                    },
                    "body": {
                        "content": "📦 Inventory Updated\nProduct: {{shopify_2.title}}\nVariant: {{shopify.variant.title}}\nSKU: {{shopify.variant.sku}}\n\nAvailabe Quantity: {{shopify.available}}\n\n🔗 https://admin.shopify.com/store/{{shopify_1.myshopifyDomain | replace: \".myshopify.com\", \"\"}}/products/{{shopify_2.legacyResourceId}}"
                    }
                },
                "local_fields": [],
                "selected_fields": ["body.content"],
                "on_error": "default",
                "weight": 2
            }
        ]
    }
}

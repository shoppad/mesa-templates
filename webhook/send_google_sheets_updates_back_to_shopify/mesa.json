{
    "key": "webhook/send_google_sheets_updates_back_to_shopify",
    "name": "Update existing Shopify products from Google Sheets",
    "version": "1.0.0",
    "enabled": false,
    "setup": true,
    "config": {
        "inputs": [
            {
                "schema": 4,
                "trigger_type": "input",
                "type": "googlesheets",
                "entity": "appscript",
                "action": "updated",
                "name": "Row Updated (Advanced)",
                "version": "v2",
                "key": "googlesheets",
                "operation_id": "appscript_record_updated",
                "metadata": {
                    "api_endpoint": "get /appscript/updated",
                    "install_code": "{{ template | label: 'Install the webhook code' }}"
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "product",
                "action": "retrieve",
                "name": "Retrieve Product",
                "version": "v2",
                "key": "shopify_1",
                "operation_id": "product",
                "metadata": {
                    "api_endpoint": "get /graphql/product/retrieve",
                    "body": {
                        "id": "{{googlesheets.data[\"Product ID\"]}}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "id",
                    "body",
                    "body.id"
                ],
                "on_error": "default",
                "weight": 0
            },
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "product",
                "action": "update",
                "name": "Update Product",
                "version": "v2",
                "key": "shopify",
                "operation_id": "productUpdate",
                "metadata": {
                    "api_endpoint": "post /graphql/product/update",
                    "body": {
                        "id": "{{shopify_1.id}}",
                        "descriptionHtml": "{{googlesheets.data.Description}}",
                        "productType": "{{googlesheets.data[\"Product Type\"]}}",
                        "title": "{{googlesheets.data[\"Product Title\"]}}",
                        "vendor": "{{googlesheets.data.Vendor}}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "id",
                    "descriptionHtml",
                    "productType",
                    "title",
                    "vendor",
                    "body",
                    "body.id",
                    "body.descriptionHtml",
                    "body.productType",
                    "body.title",
                    "body.vendor"
                ],
                "on_error": "default",
                "weight": 1
            },
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "productvariant",
                "action": "list",
                "name": "Get First Product Variant",
                "version": "v2",
                "key": "shopify_2",
                "operation_id": "productVariants",
                "metadata": {
                    "api_endpoint": "get /graphql/productVariants",
                    "body": {
                        "product_id": "{{shopify_1.legacyResourceId}}",
                        "limit": 1
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "product_id",
                    "limit",
                    "body",
                    "body.product_id",
                    "body.limit"
                ],
                "on_error": "default",
                "weight": 2
            },
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "productvariant",
                "action": "update",
                "name": "Update Product Variant",
                "version": "v2",
                "key": "shopify_3",
                "operation_id": "productVariantUpdate",
                "metadata": {
                    "api_endpoint": "post /graphql/productVariant/update",
                    "body": {
                        "productId": "{{shopify_1.id}}",
                        "id": "{{shopify_2[0].id}}",
                        "compareAtPrice": "{{googlesheets.data[\"Compare At Price\"]}}",
                        "price": "{{googlesheets.data.Price}}",
                        "sku": "{{googlesheets.data.SKU}}"
                    }
                },
                "local_fields": [],
                "selected_fields": [
                    "productId",
                    "id",
                    "compareAtPrice",
                    "price",
                    "sku",
                    "body",
                    "body.productId",
                    "body.id",
                    "body.compareAtPrice",
                    "body.price",
                    "body.sku"
                ],
                "on_error": "default",
                "weight": 3
            }
        ]
    }
}

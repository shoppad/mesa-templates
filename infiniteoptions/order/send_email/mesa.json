{
    "key": "infiniteoptions/order/send_email",
    "name": "Get Notified by Email When a Product with Options is Purchased",
    "version": "1.0.0",
    "enabled": false,
    "setup": true,
    "config": {
        "inputs": [
            {
                "schema": 4.1,
                "trigger_type": "input",
                "type": "infiniteoptions",
                "entity": "order",
                "action": "created",
                "name": "Order Created",
                "key": "infiniteoptions_order",
                "metadata": {},
                "local_fields": [],
                "on_error": "default",
                "weight": 0
            }
        ],
        "outputs": [
            {
                "schema": 3.1,
                "trigger_type": "output",
                "type": "shopify",
                "entity": "shop",
                "action": "retrieve",
                "name": "Retrieve Shop",
                "version": "v2",
                "key": "shopify",
                "operation_id": "shop",
                "metadata": {
                    "api_endpoint": "get /graphql/shop/retrieve",
                    "body": {}
                },
                "local_fields": [],
                "selected_fields": [],
                "on_error": "default",
                "weight": 0
            },
            {
                "schema": 2,
                "trigger_type": "output",
                "type": "email",
                "version": "v1",
                "is_premium": true,
                "name": "Email",
                "key": "email",
                "metadata": {
                    "to": "{{ template | label: 'What email address should receive this notification?', tokens: false, type: 'email' }}",
                    "subject": "New Infinite Options Order {{infiniteoptions_order.order.order_number}}",
                    "message": "Order Number: {{infiniteoptions_order.order.order_number}}\nAdmin Order URL: https://admin.shopify.com/store/{{shopify.myshopifyDomain | replace: \".myshopify.com\", \"\"}}/orders/{{infiniteoptions_order.order.id}}"
                },
                "local_fields": [],
                "on_error": "default",
                "weight": 1
            }
        ],
        "storage": []
    }
}